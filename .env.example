# Copy this file to .env and provide model gateway values for production.
# Non-model runtime policy remains in hms.json or an explicit config file.
MEMX_LLM_GATEWAY_URL=http://localhost:8080
MEMX_LLM_API_KEY=
MEMX_LLM_MODEL=
# auto: memory 模式用内置本地向量，production 模式用 HTTP Gateway。
# 没有 OpenAI embedding 时可显式设置为 local，并将模型名留空。
MEMX_EMBEDDING_BACKEND=auto
MEMX_EMBEDDING_MODEL=
MEMX_LLM_REQUEST_TIMEOUT_SECONDS=10
